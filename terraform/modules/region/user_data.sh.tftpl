#!/bin/bash
# Small status app: shows which Region served the request, counts visits in the
# DynamoDB global table, and checks that the Aurora endpoint is reachable.
set -euxo pipefail

dnf install -y python3-pip
pip3 install boto3

mkdir -p /opt/app
cat > /opt/app/app.py <<'PY'
import json, socket, urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import boto3

ROLE = "${role}"
REGION = "${region}"
TABLE = "${table_name}"
DB_ENDPOINT = "${db_endpoint}"

table = boto3.resource("dynamodb", region_name=REGION).Table(TABLE)


def imds(path):
    tok = urllib.request.urlopen(urllib.request.Request(
        "http://169.254.169.254/latest/api/token", method="PUT",
        headers={"X-aws-ec2-metadata-token-ttl-seconds": "60"}), timeout=2).read().decode()
    return urllib.request.urlopen(urllib.request.Request(
        "http://169.254.169.254/latest/meta-data/" + path,
        headers={"X-aws-ec2-metadata-token": tok}), timeout=2).read().decode()


INSTANCE = imds("instance-id")
AZ = imds("placement/availability-zone")


def db_reachable():
    if not DB_ENDPOINT:
        return "not configured"
    try:
        socket.create_connection((DB_ENDPOINT, 3306), timeout=2).close()
        return "reachable"
    except OSError as e:
        return "unreachable (" + str(e) + ")"


def count_visit():
    try:
        r = table.update_item(Key={"pk": "visits"}, UpdateExpression="ADD hits :one",
                              ExpressionAttributeValues={":one": 1}, ReturnValues="UPDATED_NEW")
        return int(r["Attributes"]["hits"])
    except Exception as e:
        return "error: " + str(e)


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/health":
            return self.reply(200, "text/plain", "OK")
        info = {"role": ROLE, "region": REGION, "az": AZ, "instance": INSTANCE,
                "visits_global_table": count_visit(), "aurora": DB_ENDPOINT, "aurora_status": db_reachable()}
        if self.path == "/api":
            return self.reply(200, "application/json", json.dumps(info))
        color = "#16a34a" if ROLE == "primary" else "#d97706"
        rows = "".join("<tr><th>{}</th><td>{}</td></tr>".format(k, v) for k, v in info.items())
        html = ("<html><head><title>DR demo</title></head><body style='font-family:sans-serif;max-width:640px;margin:40px auto'>"
                "<h1 style='color:{}'>Served from {} ({})</h1><table cellpadding=6>{}</table></body></html>").format(color, REGION, ROLE, rows)
        self.reply(200, "text/html", html)

    def reply(self, code, ctype, body):
        data = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def log_message(self, *args):
        pass


ThreadingHTTPServer(("0.0.0.0", 80), Handler).serve_forever()
PY

cat > /etc/systemd/system/drapp.service <<'UNIT'
[Unit]
Description=DR demo status app
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/app/app.py
Restart=always

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now drapp
